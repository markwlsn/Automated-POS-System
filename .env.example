# =============================================================================
# Automated POS System - Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# =============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# Database Storage (SQLite)
# In development/production, stores the local SQLite database file
# In test mode (NODE_ENV=test), memory database ':memory:' is used automatically
DB_PATH=./data/pos.sqlite

# JSON Web Token (JWT) Security
# Change to a strong random key in production (minimum 32 characters)
JWT_SECRET=super-secret-pos-jwt-key-minimum-32-chars-length
JWT_EXPIRES_IN=24h

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Default Single-Tenant Organization Identifiers
# Dela Cruz Meat Shop - Main Branch (Poblacion)
DEFAULT_SHOP_ID=11111111-1111-1111-1111-111111111111
DEFAULT_BRANCH_ID=22222222-2222-2222-2222-222222222222
